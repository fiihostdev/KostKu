# ===================================================================
# KOSTKU SAAS — ENVIRONMENT VARIABLES
# Copy file ini ke .env.local untuk development lokal
# Isi semua nilai sesuai petunjuk di bawah
# ===================================================================

# ── 1. SUPABASE ─────────────────────────────────────────────────────
# Dapatkan di: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── 2. MIDTRANS PAYMENT GATEWAY ─────────────────────────────────────
# Dapatkan di: dashboard.midtrans.com → Settings → Access Keys
# Untuk testing gunakan Sandbox, production gunakan Production keys
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ── 3. COOLIFY WA BOT ───────────────────────────────────────────────
# URL bot yang sudah di-deploy di Coolify (fiihosting.my.id)
# Secret harus sama dengan BOT_API_SECRET di Coolify env
NOTIFICATION_BOT_URL=https://y3qflwtwkbqp1ggqfmwvfhbb.fiihosting.my.id/api/send-notification
NOTIFICATION_BOT_SECRET=kostku_wa_secret_2026_fiihost

# ── 4. APP URL ──────────────────────────────────────────────────────
# URL production (diisi otomatis oleh Vercel)
NEXT_PUBLIC_APP_URL=https://fiihost.my.id
